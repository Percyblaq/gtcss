         get(/databases/$(database)/documents/announcements/$(announcementId)).data.status == 'Published' &&
         get(/databases/$(database)/documents/announcements/$(announcementId)).data.targetAudience in ['All', 'Teachers', 'Specific Classes']) ||
        (isParent() &&
         get(/databases/$(database)/documents/announcements/$(announcementId)).data.status == 'Published' &&
         get(/databases/$(database)/documents/announcements/$(announcementId)).data.targetAudience in ['All', 'Parents', 'Students', 'Specific Classes'])
      );
