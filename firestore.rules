             data.deletedAt is string && data.deletedAt.size() > 0 && data.deletedAt.size() <= 50;
    }

    function isValidFeeAuditSnapshot(snap) {
      return snap is map &&
             snap.keys().hasOnly([
               'expectedAmount', 'dueDate', 'paidAmount', 'balance', 'status',
               'amount', 'paymentDate', 'paymentMethod', 'notes', 'receiptNo'
             ]) &&
             (!snap.keys().hasAny(['expectedAmount']) || (snap.expectedAmount is number && snap.expectedAmount >= 0 && snap.expectedAmount <= 50000000)) &&
             (!snap.keys().hasAny(['dueDate']) || (snap.dueDate is string && snap.dueDate.size() <= 40)) &&
             (!snap.keys().hasAny(['paidAmount']) || (snap.paidAmount is number && snap.paidAmount >= 0 && snap.paidAmount <= 50000000)) &&
             (!snap.keys().hasAny(['balance']) || (snap.balance is number && snap.balance >= 0 && snap.balance <= 50000000)) &&
             (!snap.keys().hasAny(['status']) || (snap.status is string && snap.status.size() <= 20)) &&
             (!snap.keys().hasAny(['amount']) || (snap.amount is number && snap.amount >= 0 && snap.amount <= 50000000)) &&
             (!snap.keys().hasAny(['paymentDate']) || (snap.paymentDate is string && snap.paymentDate.size() <= 20)) &&
             (!snap.keys().hasAny(['paymentMethod']) || (snap.paymentMethod is string && snap.paymentMethod.size() <= 40)) &&
             (!snap.keys().hasAny(['notes']) || (snap.notes is string && snap.notes.size() <= 300)) &&
             (!snap.keys().hasAny(['receiptNo']) || (snap.receiptNo is string && snap.receiptNo.size() <= 500));
    }

    function isValidFeeAuditLog(data) {
      return data.keys().hasAll([
               'actionType', 'studentId', 'studentName', 'admissionNo', 'className',
               'session', 'term', 'studentFeeId', 'categoryId', 'categoryName',
               'receiptNo', 'reason', 'oldValues', 'newValues',
               'performedBy', 'performedByUid', 'performedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'actionType', 'studentId', 'studentName', 'admissionNo', 'className',
               'session', 'term', 'studentFeeId', 'categoryId', 'categoryName',
               'paymentId', 'receiptNo', 'reason', 'oldValues', 'newValues',
               'performedBy', 'performedByUid', 'performedAt'
             ]) &&
             (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() > 0 && data.id.size() <= 128)) &&
             data.actionType in ['edit_payment', 'edit_expected_amount', 'edit_due_date', 'void_payment', 'delete_fee_item'] &&
             data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128 &&
             data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 150 &&
             data.admissionNo is string && data.admissionNo.size() > 0 && data.admissionNo.size() <= 30 &&
             data.className is string && data.className.size() > 0 && data.className.size() <= 60 &&
             data.session is string && data.session.size() > 0 && data.session.size() <= 40 &&
             data.term in ['First Term', 'Second Term', 'Third Term'] &&
             data.studentFeeId is string && data.studentFeeId.size() > 0 && data.studentFeeId.size() <= 128 &&
             data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 128 &&
             data.categoryName is string && data.categoryName.size() > 0 && data.categoryName.size() <= 100 &&
             (!data.keys().hasAny(['paymentId']) || (data.paymentId is string && data.paymentId.size() > 0 && data.paymentId.size() <= 128)) &&
             data.receiptNo is string && data.receiptNo.size() > 0 && data.receiptNo.size() <= 500 &&
             data.reason is string && data.reason.size() > 0 && data.reason.size() <= 300 &&
             isValidFeeAuditSnapshot(data.oldValues) &&
             isValidFeeAuditSnapshot(data.newValues) &&
             data.performedBy is string && data.performedBy.size() > 0 && data.performedBy.size() <= 120 &&
             data.performedByUid is string && data.performedByUid.size() > 0 && data.performedByUid.size() <= 128 &&
             data.performedAt is string && data.performedAt.size() > 0 && data.performedAt.size() <= 50;
    }

    // ==================== COLLECTION RULES ====================

    // Connection validation healthcheck (strictly single-doc get, no list/write)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // Users Collection (RBAC Profiles)
    match /users/{userId} {
      allow get: if isEmailVerified() && isValidId(userId) && (isOwner(userId) || isPrincipal());
      allow list: if isPrincipal();
      allow create: if isEmailVerified() && isValidId(userId) && isValidUser(incoming()) && (
        isDirector() ||
        (isOwner(userId) &&
         incoming().uid == userId &&
         request.auth.token.email != null &&
         incoming().email.lower() == request.auth.token.email.lower() && (
          (request.auth.token.email.lower() == "patrickpercy1989@gmail.com" &&
           incoming().role == 'director' &&
           (!incoming().keys().hasAny(['isActive']) || incoming().isActive == true)) ||
          (matchesActiveStaffInvite(incoming()) &&
           (!incoming().keys().hasAny(['isActive']) || incoming().isActive == true)) ||
          (incoming().role == 'parent' &&
           (!incoming().keys().hasAny(['isActive']) || incoming().isActive == true) &&
           (!incoming().keys().hasAny(['assignedClasses']) || incoming().assignedClasses.size() == 0) &&
           (!incoming().keys().hasAny(['assignedSubjects']) || incoming().assignedSubjects.size() == 0) &&
           (!incoming().keys().hasAny(['subjects']) || incoming().subjects.size() == 0) &&
           (!incoming().keys().hasAny(['primarySubject']) || incoming().primarySubject == '') &&
           (!incoming().keys().hasAny(['linkedStudentIds']) || incoming().linkedStudentIds.size() == 0))
        ))
      );
      allow update: if isAccountActive() && isValidId(userId) && isValidUser(incoming()) && (
        isDirector() ||
        (isOwner(userId) &&
         existing().role != 'parent' &&
         incoming().uid == existing().uid &&
         incoming().email == existing().email &&
         incoming().role == existing().role &&
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'avatar', 'updatedAt']))
      );
      allow delete: if isDirector() && isValidId(userId);
    }

    // Director-Provisioned Staff & Parent Invites (anti-enumeration hardened)
    match /staffInvites/{inviteId} {
      allow get: if isEmailVerified() && isValidId(inviteId) && (
        isDirector() ||
        (request.auth.token.email != null &&
         resource != null &&
         resource.data.email.lower() == request.auth.token.email.lower())
      );
      allow list: if isDirector();
      allow create, update: if isDirector() && isValidId(inviteId) && isValidStaffInvite(incoming());
      allow delete: if isDirector() && isValidId(inviteId);
    }

    // Students Collection (Parents read ONLY students whose Parent Email matches their verified Google email; zero writes)
    match /students/{studentId} {
      allow get: if isAccountActive() && (
        isPrincipal() ||
        isHeadTeacher() ||
        isBursar() ||
        (isTeacher() && teacherHasClass(resource.data.className)) ||
        parentEmailMatches(resource.data.guardianEmail)
      );
      allow list: if isAccountActive() && (
        isPrincipal() ||
        isHeadTeacher() ||
        isBursar() ||
        (isTeacher() && teacherHasClass(resource.data.className)) ||
        parentEmailMatches(resource.data.guardianEmail)
      );
      allow create: if isPrincipal() && isValidId(studentId) && isValidStudent(incoming());
      allow update: if isValidId(studentId) && isValidStudent(incoming()) && (
        isPrincipal() ||
        (isBursar() &&
         incoming().diff(existing()).affectedKeys().hasOnly(['feeStatus', 'updatedAt']))
      );
      allow delete: if isDirector() && isValidId(studentId);
    }

    // Teachers Collection (Strictly hidden from Parent role)
    match /teachers/{teacherId} {
      allow get, list: if isPrincipal() || isHeadTeacher() || isTeacher();
      allow create: if isDirector() && isValidId(teacherId) && isValidTeacher(incoming());
      allow update: if isValidId(teacherId) && isValidTeacher(incoming()) && (
        isDirector() ||
        (isPrincipal() &&
         incoming().employmentStatus == existing().employmentStatus &&
         incoming().staffId == existing().staffId)
      );
      allow delete: if isDirector() && isValidId(teacherId);
    }

    // Academic Sessions & Terms
    match /academicSessions/{sessionId} {
      allow get, list: if isAccountActive();
      allow create, update: if isPrincipal() && isValidId(sessionId) && isValidAcademicSession(incoming());
      allow delete: if isDirector() && isValidId(sessionId);
    }

    // Classes & Assigned Subjects (Nursery, Primary, JSS, SSS)
    match /classes/{classId} {
      allow get, list: if isAccountActive();
      allow create, update: if isPrincipal() && isValidId(classId) && isValidClass(incoming());
      allow delete: if isDirector() && isValidId(classId);
    }

    // Configurable Assessment Components, Grading Boundaries & Ranking Policy
    match /academicConfig/{configId} {
      allow get, list: if isAccountActive();
      allow create, update: if isPrincipal() && isValidId(configId) && isValidAcademicConfig(incoming());
      allow delete: if isDirector() && isValidId(configId);
    }

    // Subject-Teacher-Class Assignments (Strictly hidden from Parent role)
    match /subjectAssignments/{assignmentId} {
      allow get, list: if isPrincipal() || isHeadTeacher() || isTeacher();
      allow create, update: if isPrincipal() && isValidId(assignmentId) && isValidSubjectAssignment(incoming());
      allow delete: if isPrincipal() && isValidId(assignmentId);
    }

    // Result Reviews, Three-Tier Comments & Approvals (Staff only — Parents use frozen publishedReports snapshots)
    match /resultReviews/{reviewId} {
      allow get: if isAccountActive() && (
        isPrincipal() ||
        isHeadTeacher() ||
        (isTeacher() && teacherHasClass(resource.data.className))
      );
      allow list: if isAccountActive() && (
        isPrincipal() ||
        isHeadTeacher() ||
        (isTeacher() && teacherHasClass(resource.data.className))
      );
      allow create: if isValidId(reviewId) && isValidResultReview(incoming()) && (
        isDirector() ||
        (isTeacher() &&
         teacherHasClass(incoming().className) &&
         incoming().status in ['Draft', 'Submitted for Review'] &&
         (!incoming().keys().hasAny(['headComment']) || incoming().headComment == '') &&
         (!incoming().keys().hasAny(['headCommentBy']) || incoming().headCommentBy == '') &&
         (!incoming().keys().hasAny(['headSignature']) || incoming().headSignature == '') &&
         (!incoming().keys().hasAny(['principalComment']) || incoming().principalComment == '') &&
         (!incoming().keys().hasAny(['principalCommentBy']) || incoming().principalCommentBy == '') &&
         (!incoming().keys().hasAny(['principalSignature']) || incoming().principalSignature == '') &&
         !incoming().keys().hasAny(['approvedBy', 'approvedAt'])) ||
        (isHeadTeacher() &&
         incoming().status in ['Draft', 'Submitted for Review'] &&
         (!incoming().keys().hasAny(['teacherComment']) || incoming().teacherComment == '') &&
         (!incoming().keys().hasAny(['teacherCommentBy']) || incoming().teacherCommentBy == '') &&
         (!incoming().keys().hasAny(['principalComment']) || incoming().principalComment == '') &&
         (!incoming().keys().hasAny(['principalCommentBy']) || incoming().principalCommentBy == '') &&
         (!incoming().keys().hasAny(['principalSignature']) || incoming().principalSignature == '') &&
         !incoming().keys().hasAny(['approvedBy', 'approvedAt'])) ||
        (isPrincipal() &&
         (!incoming().keys().hasAny(['teacherComment']) || incoming().teacherComment == '') &&
         (!incoming().keys().hasAny(['teacherCommentBy']) || incoming().teacherCommentBy == '') &&
         (!incoming().keys().hasAny(['headComment']) || incoming().headComment == '') &&
         (!incoming().keys().hasAny(['headCommentBy']) || incoming().headCommentBy == '') &&
         (!incoming().keys().hasAny(['headSignature']) || incoming().headSignature == ''))
      );
      allow update: if isValidId(reviewId) && isValidResultReview(incoming()) &&
        incoming().studentId == existing().studentId &&
        incoming().className == existing().className &&
        incoming().term == existing().term &&
        incoming().session == existing().session && (
        isDirector() ||
        (isTeacher() &&
         teacherHasClass(incoming().className) &&
         (incoming().status in ['Draft', 'Submitted for Review'] || incoming().status == existing().status) &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'teacherComment', 'teacherCommentBy', 'teacherCommentAt',
           'status', 'updatedAt', 'guardianEmail', 'studentName', 'id'
         ])) ||
        (isHeadTeacher() &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'headComment', 'headCommentBy', 'headCommentTitle', 'headCommentAt', 'headSignature',
           'updatedAt', 'guardianEmail', 'studentName', 'id'
         ])) ||
        (isPrincipal() &&
         incoming().diff(existing()).affectedKeys().hasOnly([
           'principalComment', 'principalCommentBy', 'principalCommentAt', 'principalSignature',
           'status', 'reviewedBy', 'reviewedAt', 'approvedBy', 'approvedAt', 'returnNote',
           'updatedAt', 'guardianEmail', 'studentName', 'id'
         ]))
      );
      allow delete: if isDirector() && isValidId(reviewId);
    }

    // Frozen Published Report Card Snapshots
    // Director, Principal, and Head Teacher can read, create, update, and delete;
    // verified signed-in parents can read ONLY published reports whose guardianEmail matches their verified Google email in lowercase, and cannot write;
    // everyone else has no access.
    match /publishedReports/{reportId} {
      allow get, list: if canManagePublishedReports() || (
        isParent() &&
        request.auth.token.email != null &&
        request.auth.token.email.size() > 0 &&
        resource.data.isPublished == true &&
        resource.data.guardianEmail == request.auth.token.email.lower()
      );
      allow create, update, delete: if canManagePublishedReports();
    }

    // Report Card Publish/Republish/Unpublish Audit Log
    // Director, Principal, and Head Teacher roles only; everyone else has no access.
    match /reportPublishAuditLogs/{logId} {
      allow get, list, create, update, delete: if canManagePublishedReports();
    }

    // Academic Assessment Records (Staff only — Parents read frozen publishedReports snapshots only)
    match /academics/{recordId} {
      allow get: if isAccountActive() && (
        isPrincipal() ||
        isHeadTeacher() ||
        (isTeacher() && teacherHasClass(resource.data.className))
      );
      allow list: if isAccountActive() && (
        isPrincipal() ||
        isHeadTeacher() ||
        (isTeacher() && teacherHasClass(resource.data.className))
      );
      allow create: if isValidId(recordId) && isValidAcademicRecord(incoming()) && (
        isPrincipal() ||
        (isTeacher() &&
         teacherHasClass(incoming().className) &&
         teacherHasSubject(incoming().subject) &&
         (!incoming().keys().hasAny(['isApproved']) || incoming().isApproved == false))
      );
      allow update: if isValidId(recordId) && isValidAcademicRecord(incoming()) &&
        incoming().studentId == existing().studentId &&
        incoming().className == existing().className &&
        incoming().subject == existing().subject &&
        incoming().term == existing().term &&
        incoming().session == existing().session && (
        isPrincipal() ||
        (isTeacher() &&
         teacherHasClass(incoming().className) &&
         teacherHasSubject(incoming().subject) &&
         (!incoming().keys().hasAny(['isApproved']) || incoming().isApproved == false))
      );
      allow delete: if isDirector() && isValidId(recordId);
    }

    // Attendance Register Records (Staff only — Parents read attendance summary inside publishedReports snapshots)
    match /attendance/{recordId} {
      allow get: if isAccountActive() && (
        isPrincipal() ||
        isHeadTeacher() ||
        (isTeacher() && teacherHasClass(resource.data.className))
      );
      allow list: if isAccountActive() && (
        isPrincipal() ||
        isHeadTeacher() ||
        (isTeacher() && teacherHasClass(resource.data.className))
      );
      allow create: if isValidId(recordId) && isValidAttendance(incoming()) && (
        isDirector() ||
        isPrincipal() ||
        (isTeacher() && teacherHasClass(incoming().className))
      );
      allow update: if isValidId(recordId) && isValidAttendance(incoming()) &&
        incoming().studentId == existing().studentId &&
        incoming().date == existing().date &&
        incoming().className == existing().className && (
        isDirector() ||
        isPrincipal() ||
        (isTeacher() && teacherHasClass(existing().className) && teacherHasClass(incoming().className))
      );
      allow delete: if isDirector() && isValidId(recordId);
    }

    // Announcements & School Circulars (Role-isolated)
    match /announcements/{announcementId} {
      allow get: if isAccountActive() && (
        isPrincipal() ||
        ((isTeacher() || isHeadTeacher() || isBursar()) && resource.data.status == 'Published' && resource.data.targetAudience in ['All', 'Teachers', 'Specific Classes']) ||
        (isParent() && resource.data.status == 'Published' && resource.data.targetAudience in ['All', 'Parents', 'Students', 'Specific Classes'])
      );
      allow list: if isAccountActive() && (
        isPrincipal() ||
        ((isTeacher() || isHeadTeacher() || isBursar()) && resource.data.status == 'Published' && resource.data.targetAudience in ['All', 'Teachers', 'Specific Classes']) ||
        (isParent() && resource.data.status == 'Published' && resource.data.targetAudience in ['All', 'Parents', 'Students', 'Specific Classes'])
      );
      allow create, update: if isPrincipal() && isValidId(announcementId) && isValidAnnouncement(incoming());
      allow delete: if isDirector() && isValidId(announcementId);

      // Comments on Announcements (Parents & Staff can view and post comments on announcements visible to them;
      // comments cannot be edited; only Director or Principal can delete comments)
      match /comments/{commentId} {
        allow get: if isValidId(announcementId) && isValidId(commentId) && canReadAnnouncementForComments(announcementId);
        allow list: if isValidId(announcementId) && canReadAnnouncementForComments(announcementId);
        allow create: if isValidId(announcementId) &&
          isValidId(commentId) &&
          canReadAnnouncementForComments(announcementId) &&
          isValidAnnouncementComment(incoming(), announcementId) &&
          (incoming().authorRole == getUserDoc().role || (isDirector() && incoming().authorRole == 'director'));
        allow update: if false;
        allow delete: if isValidId(announcementId) && isValidId(commentId) && (isDirector() || isPrincipal());
      }
    }

    // Published School Calendar Events (Exams, Resumption Dates, Holidays)
    match /schoolCalendarEvents/{eventId} {
      allow get, list: if isAccountActive();
      allow create, update: if isPrincipal() && isValidId(eventId) && isValidCalendarEvent(incoming());
      allow delete: if isPrincipal() && isValidId(eventId);
    }

    // School Settings (Session, Term, Currency, Full Profile & Branding)
    match /settings/{settingId} {
      allow get, list: if isAccountActive();
      allow create, update: if isDirector() && isValidId(settingId) && isValidSchoolSetting(incoming());
      allow delete: if isDirector() && isValidId(settingId);
    }

    // Public School Branding (Non-PII school name, motto, logo URL for login screen; Director write only)
    match /branding/{docId} {
      allow get: if docId == 'school' && isValidId(docId);
      allow list: if false;
      allow create, update: if isDirector() && docId == 'school' && isValidPublicBranding(incoming());
      allow delete: if isDirector() && docId == 'school';
    }

    // Class Weekly Timetable Slots
    match /timetable/{slotId} {
      allow get, list: if isAccountActive();
      allow create, update: if isPrincipal() && isValidId(slotId) && isValidTimetableSlot(incoming());
      allow delete: if isPrincipal() && isValidId(slotId);
    }

    // ==================== SCHOOL FEES & PAYMENT RECORDING ====================

    // Fee Categories (Admin & Bursar view; Director & Principal manage)
    match /feeCategories/{categoryId} {
      allow get, list: if isPrincipal() || isBursar();
      allow create, update: if isPrincipal() && isValidId(categoryId) && isValidFeeCategory(incoming());
      allow delete: if isDirector() && isValidId(categoryId);
    }

    // Class, Term & Session Fee Schedules (Admin & Bursar view; Director & Principal manage)
    match /feeSchedules/{scheduleId} {
      allow get, list: if isPrincipal() || isBursar();
      allow create, update: if isPrincipal() && isValidId(scheduleId) && isValidFeeSchedule(incoming());
      allow delete: if isPrincipal() && isValidId(scheduleId);
    }

    // Assigned Student Fees (Never created as Paid without payment records; only Bursar/Director update payment totals)
    match /studentFees/{studentFeeId} {
      allow get: if isAccountActive() && (
        isPrincipal() ||
        isBursar() ||
        (isParent() && parentHasWard(resource.data.studentId, resource.data.guardianEmail))
      );
      allow list: if isAccountActive() && (
        isPrincipal() ||
        isBursar() ||
        (isParent() && parentHasWard(resource.data.studentId, resource.data.guardianEmail))
      );
      allow create: if isPrincipal() && isValidId(studentFeeId) && isValidStudentFee(incoming()) &&
        incoming().amountPaid == 0 &&
        incoming().status == 'Pending' &&
        incoming().balance == incoming().amountDue;
      allow update: if isValidId(studentFeeId) && isValidStudentFee(incoming()) &&
        incoming().studentId == existing().studentId &&
        incoming().session == existing().session &&
        incoming().term == existing().term &&
        incoming().categoryId == existing().categoryId &&
        (isDirector() || (
          isBursar() &&
          incoming().amountDue == existing().amountDue &&
          incoming().diff(existing()).affectedKeys().hasOnly(['amountPaid', 'balance', 'status', 'updatedAt'])
        ));
      allow delete: if isDirector() && isValidId(studentFeeId);
    }

    // Manually Recorded Fee Payments & Unique Receipts (Strictly Bursar/Accountant & Director can record; Director-only edits/voids)
    match /feePayments/{paymentId} {
      allow get: if isAccountActive() && (
        isPrincipal() ||
        isBursar() ||
        (isParent() && parentHasWard(resource.data.studentId, resource.data.guardianEmail))
      );
      allow list: if isAccountActive() && (
        isPrincipal() ||
        isBursar() ||
        (isParent() && parentHasWard(resource.data.studentId, resource.data.guardianEmail))
      );
      allow create: if isBursar() && isValidId(paymentId) && isValidFeePayment(incoming()) &&
        incoming().recordedByUid == request.auth.uid &&
        (!incoming().keys().hasAny(['isVoided']) || incoming().isVoided == false) &&
        (!incoming().keys().hasAny(['isEdited']) || incoming().isEdited == false) &&
        existsAfter(/databases/$(database)/documents/studentFees/$(incoming().studentFeeId));
      allow update: if isDirector() && isValidId(paymentId) && isValidFeePayment(incoming()) &&
        incoming().receiptNo == existing().receiptNo &&
        incoming().studentFeeId == existing().studentFeeId &&
        incoming().studentId == existing().studentId &&
        incoming().session == existing().session &&
        incoming().term == existing().term &&
        incoming().categoryId == existing().categoryId &&
        (!incoming().keys().hasAny(['isVoided']) || incoming().isVoided == false || (
          incoming().voidedByUid == request.auth.uid &&
          incoming().keys().hasAny(['voidReason']) &&
          incoming().voidReason.size() > 0
        ));
      allow delete: if isDirector() && isValidId(paymentId);
    }

    // Fee & Payment Deletion Audit Logs (Strictly Director-only, immutable)
    match /feeDeletionLogs/{logId} {
      allow get, list: if isDirector();
      allow create: if isDirector() && isValidId(logId) && isValidFeeDeletionLog(incoming()) &&
        incoming().deletedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Full Fee Edit, Void & Deletion Audit Logs (Strictly Director-only, immutable)
    match /feeAuditLogs/{logId} {
      allow get, list: if isDirector();
      allow create: if isDirector() && isValidId(logId) && isValidFeeAuditLog(incoming()) &&
        incoming().performedByUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
