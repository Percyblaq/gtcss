rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== CORE SECURITY HELPERS ====================

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isEmailVerified() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDataImageUrl(val, maxBytes) {
      return val is string &&
             val.size() <= maxBytes &&
             (
               val.size() == 0 ||
               (val.size() >= 22 && val[0:22] == 'data:image/png;base64,') ||
               (val.size() >= 23 && val[0:23] == 'data:image/jpeg;base64,') ||
               (val.size() >= 23 && val[0:23] == 'data:image/webp;base64,')
             );
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Account status check: Requires verified email, valid /users/{uid} profile, and active flag
    function isAccountActive() {
      return isEmailVerified() &&
             hasUserDoc() &&
             (!getUserDoc().keys().hasAny(['isActive']) || getUserDoc().isActive == true);
    }

    function isDirector() {
      return isAccountActive() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == "patrickpercy1989@gmail.com") ||
        getUserDoc().role == 'director'
      );
    }

    function isPrincipal() {
      return isAccountActive() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == "patrickpercy1989@gmail.com") ||
        getUserDoc().role in ['director', 'principal']
      );
    }

    function isHeadTeacher() {
      return isAccountActive() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == "patrickpercy1989@gmail.com") ||
        getUserDoc().role in ['director', 'head_teacher']
      );
    }

    function canManagePublishedReports() {
      return (isEmailVerified() &&
              request.auth.token.email != null &&
              request.auth.token.email.lower() == "patrickpercy1989@gmail.com") ||
             (isAccountActive() && getUserDoc().role in ['director', 'principal', 'head_teacher']);
    }

    function isBursar() {
      return isAccountActive() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == "patrickpercy1989@gmail.com") ||
        getUserDoc().role in ['director', 'bursar']
      );
    }

    function isTeacher() {
      return isAccountActive() && getUserDoc().role == 'teacher';
    }

    function isParent() {
      return isAccountActive() && getUserDoc().role == 'parent';
    }

    // Teacher class & subject restriction helpers
    function teacherHasClass(className) {
      return isTeacher() &&
             getUserDoc().keys().hasAny(['assignedClasses']) &&
             (className in getUserDoc().assignedClasses);
    }

    function teacherHasSubject(subject) {
      return isTeacher() && (
        !getUserDoc().keys().hasAny(['assignedSubjects']) ||
        getUserDoc().assignedSubjects.size() == 0 ||
        (subject in getUserDoc().assignedSubjects)
      );
    }

    // Parent ward restriction helper (statically verifiable by Firestore list query analyzer)
    function parentEmailMatches(guardianEmail) {
      return isParent() &&
             request.auth.token.email != null &&
             request.auth.token.email.size() > 0 &&
             (guardianEmail == request.auth.token.email.lower() ||
              guardianEmail == request.auth.token.email);
    }

    function parentHasWard(studentId, guardianEmail) {
      return parentEmailMatches(guardianEmail) || (
        isParent() &&
        getUserDoc().keys().hasAny(['linkedStudentIds']) &&
        (studentId in getUserDoc().linkedStudentIds)
      );
    }

    // ==================== STRICT SCHEMA VALIDATORS ====================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role']) &&
             data.keys().hasOnly([
               'uid', 'email', 'displayName', 'role', 'isActive', 'inviteId',
               'phone', 'avatar', 'title', 'assignedClasses', 'assignedSubjects',
               'subjects', 'primarySubject',
               'linkedStudentIds', 'linkedStudentNames', 'wardName', 'wardAdmissionNo',
               'createdAt', 'updatedAt', 'deactivatedAt', 'deactivatedBy'
             ]) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.role in ['director', 'principal', 'head_teacher', 'bursar', 'teacher', 'parent'] &&
             (!data.keys().hasAny(['isActive']) || data.isActive is bool) &&
             (!data.keys().hasAny(['inviteId']) || (data.inviteId is string && data.inviteId.size() <= 128)) &&
             (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 30)) &&
             (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 500)) &&
             (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() <= 100)) &&
             (!data.keys().hasAny(['assignedClasses']) || (data.assignedClasses is list && data.assignedClasses.size() <= 40)) &&
             (!data.keys().hasAny(['assignedSubjects']) || (data.assignedSubjects is list && data.assignedSubjects.size() <= 40)) &&
             (!data.keys().hasAny(['subjects']) || (data.subjects is list && data.subjects.size() <= 40)) &&
             (!data.keys().hasAny(['primarySubject']) || (data.primarySubject is string && data.primarySubject.size() <= 100)) &&
             (!data.keys().hasAny(['linkedStudentIds']) || (data.linkedStudentIds is list && data.linkedStudentIds.size() <= 20)) &&
             (!data.keys().hasAny(['linkedStudentNames']) || (data.linkedStudentNames is list && data.linkedStudentNames.size() <= 20)) &&
             (!data.keys().hasAny(['wardName']) || (data.wardName is string && data.wardName.size() <= 150)) &&
             (!data.keys().hasAny(['wardAdmissionNo']) || (data.wardAdmissionNo is string && data.wardAdmissionNo.size() <= 40)) &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 50)) &&
             (!data.keys().hasAny(['deactivatedAt']) || (data.deactivatedAt is string && data.deactivatedAt.size() <= 50)) &&
             (!data.keys().hasAny(['deactivatedBy']) || (data.deactivatedBy is string && data.deactivatedBy.size() <= 120));
    }

    function isValidStaffInvite(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'isActive']) &&
             data.keys().hasOnly([
               'id', 'email', 'displayName', 'role', 'isActive', 'phone', 'title',
               'assignedClasses', 'assignedSubjects', 'subjects', 'primarySubject',
               'linkedStudentIds', 'linkedStudentNames',
               'wardName', 'wardAdmissionNo', 'provisionedBy', 'createdAt', 'updatedAt'
             ]) &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.role in ['director', 'principal', 'head_teacher', 'bursar', 'teacher', 'parent'] &&
             data.isActive is bool &&
             (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() <= 128)) &&
             (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 30)) &&
             (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() <= 100)) &&
             (!data.keys().hasAny(['assignedClasses']) || (data.assignedClasses is list && data.assignedClasses.size() <= 40)) &&
             (!data.keys().hasAny(['assignedSubjects']) || (data.assignedSubjects is list && data.assignedSubjects.size() <= 40)) &&
             (!data.keys().hasAny(['subjects']) || (data.subjects is list && data.subjects.size() <= 40)) &&
             (!data.keys().hasAny(['primarySubject']) || (data.primarySubject is string && data.primarySubject.size() <= 100)) &&
             (!data.keys().hasAny(['linkedStudentIds']) || (data.linkedStudentIds is list && data.linkedStudentIds.size() <= 20)) &&
             (!data.keys().hasAny(['linkedStudentNames']) || (data.linkedStudentNames is list && data.linkedStudentNames.size() <= 20)) &&
             (!data.keys().hasAny(['wardName']) || (data.wardName is string && data.wardName.size() <= 150)) &&
             (!data.keys().hasAny(['wardAdmissionNo']) || (data.wardAdmissionNo is string && data.wardAdmissionNo.size() <= 40)) &&
             (!data.keys().hasAny(['provisionedBy']) || (data.provisionedBy is string && data.provisionedBy.size() <= 120)) &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function matchesActiveStaffInvite(data) {
      return data.keys().hasAny(['inviteId']) &&
             isValidId(data.inviteId) &&
             exists(/databases/$(database)/documents/staffInvites/$(data.inviteId)) &&
             get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.isActive == true &&
             request.auth.token.email != null &&
             get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.email.lower() == request.auth.token.email.lower() &&
             data.role == get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.role &&
             (!data.keys().hasAny(['assignedClasses']) || !get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.keys().hasAny(['assignedClasses']) || data.assignedClasses == get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.assignedClasses) &&
             (!data.keys().hasAny(['assignedSubjects']) || !get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.keys().hasAny(['assignedSubjects']) || data.assignedSubjects == get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.assignedSubjects) &&
             (!data.keys().hasAny(['subjects']) || !get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.keys().hasAny(['subjects']) || data.subjects == get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.subjects) &&
             (!data.keys().hasAny(['primarySubject']) || !get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.keys().hasAny(['primarySubject']) || data.primarySubject == get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.primarySubject) &&
             (!data.keys().hasAny(['linkedStudentIds']) || !get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.keys().hasAny(['linkedStudentIds']) || data.linkedStudentIds == get(/databases/$(database)/documents/staffInvites/$(data.inviteId)).data.linkedStudentIds);
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['admissionNo', 'firstName', 'surname', 'fullName', 'dateOfBirth', 'gender', 'classId', 'className', 'guardianName', 'guardianPhone', 'address', 'admissionDate', 'status']) &&
             data.keys().hasOnly([
               'id', 'admissionNo', 'firstName', 'middleName', 'surname', 'fullName',
               'dateOfBirth', 'gender', 'classId', 'className', 'guardianName',
               'guardianPhone', 'guardianEmail', 'address', 'admissionDate',
               'passportPhoto', 'status', 'feeStatus', 'stateOfOrigin', 'lga',
               'bloodGroup', 'termAverageScore', 'overallPosition', 'createdAt', 'updatedAt'
             ]) &&
             data.admissionNo is string && data.admissionNo.size() > 0 && data.admissionNo.size() <= 30 &&
             data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 60 &&
             (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() <= 128)) &&
             (!data.keys().hasAny(['middleName']) || (data.middleName is string && data.middleName.size() <= 60)) &&
             data.surname is string && data.surname.size() > 0 && data.surname.size() <= 60 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150 &&
             data.dateOfBirth is string && data.dateOfBirth.size() <= 20 &&
             data.gender in ['Male', 'Female'] &&
             data.classId is string && data.classId.size() <= 50 &&
             data.className is string && data.className.size() <= 50 &&
             data.guardianName is string && data.guardianName.size() > 0 && data.guardianName.size() <= 100 &&
             data.guardianPhone is string && data.guardianPhone.size() > 0 && data.guardianPhone.size() <= 30 &&
             (!data.keys().hasAny(['guardianEmail']) || (data.guardianEmail is string && data.guardianEmail.size() <= 128)) &&
             data.address is string && data.address.size() > 0 && data.address.size() <= 300 &&
             data.admissionDate is string && data.admissionDate.size() <= 20 &&
             (!data.keys().hasAny(['passportPhoto']) || (data.passportPhoto is string && data.passportPhoto.size() <= 300000)) &&
             data.status in ['Active', 'Graduated', 'Withdrawn', 'Suspended'] &&
             (!data.keys().hasAny(['feeStatus']) || data.feeStatus in ['Paid', 'Partial', 'Pending']) &&
             (!data.keys().hasAny(['stateOfOrigin']) || (data.stateOfOrigin is string && data.stateOfOrigin.size() <= 60)) &&
             (!data.keys().hasAny(['lga']) || (data.lga is string && data.lga.size() <= 80)) &&
             (!data.keys().hasAny(['bloodGroup']) || (data.bloodGroup is string && data.bloodGroup.size() <= 10)) &&
             (!data.keys().hasAny(['termAverageScore']) || (data.termAverageScore is number && data.termAverageScore >= 0 && data.termAverageScore <= 100)) &&
             (!data.keys().hasAny(['overallPosition']) || (data.overallPosition is number && data.overallPosition >= 1)) &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['staffId', 'fullName', 'phone', 'email', 'address', 'qualifications', 'employmentDate', 'employmentStatus']) &&
             data.keys().hasOnly([
               'id', 'staffId', 'fullName', 'gender', 'phone', 'email', 'address',
               'qualifications', 'subjects', 'assignedClasses', 'roleType',
               'employmentDate', 'employmentStatus', 'createdAt', 'updatedAt'
             ]) &&
             (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() <= 128)) &&
             data.staffId is string && data.staffId.size() > 0 && data.staffId.size() <= 30 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
             (!data.keys().hasAny(['gender']) || data.gender in ['Male', 'Female']) &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             data.address is string && data.address.size() > 0 && data.address.size() <= 300 &&
             data.qualifications is string && data.qualifications.size() > 0 && data.qualifications.size() <= 250 &&
             (!data.keys().hasAny(['subjects']) || (data.subjects is list && data.subjects.size() <= 30)) &&
             (!data.keys().hasAny(['assignedClasses']) || (data.assignedClasses is list && data.assignedClasses.size() <= 30)) &&
             (!data.keys().hasAny(['roleType']) || data.roleType in ['Head of Department', 'Form Teacher', 'Subject Teacher', 'Vice Principal']) &&
             data.employmentDate is string && data.employmentDate.size() <= 20 &&
             data.employmentStatus in ['Active', 'On Leave', 'Deactivated'] &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidAcademicSession(data) {
      return data.keys().hasAll(['name', 'isActive', 'startDate', 'endDate', 'terms']) &&
             data.keys().hasOnly(['id', 'name', 'isActive', 'startDate', 'endDate', 'terms', 'createdAt', 'updatedAt']) &&
             (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() <= 128)) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 40 &&
             data.isActive is bool &&
             data.startDate is string && data.startDate.size() <= 20 &&
             data.endDate is string && data.endDate.size() <= 20 &&
             data.terms is list && data.terms.size() <= 5 &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidClass(data) {
      return data.keys().hasAll(['name', 'section', 'level', 'arm', 'capacity']) &&
             data.keys().hasOnly([
               'id', 'name', 'section', 'level', 'arm', 'formTeacherName',
               'formTeacherId', 'capacity', 'totalStudents', 'roomNumber',
               'subjects', 'isActive', 'sortOrder', 'notes', 'createdAt', 'updatedAt'
             ]) &&
             (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() <= 128)) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 60 &&
             data.section in ['Creche', 'Nursery', 'Primary', 'Junior Secondary', 'Senior Secondary'] &&
             data.level is string && data.level.size() > 0 && data.level.size() <= 60 &&
             data.arm is string && data.arm.size() <= 80 &&
             data.capacity is number && data.capacity > 0 && data.capacity <= 500 &&
             (!data.keys().hasAny(['formTeacherName']) || (data.formTeacherName is string && data.formTeacherName.size() <= 120)) &&
             (!data.keys().hasAny(['formTeacherId']) || (data.formTeacherId is string && data.formTeacherId.size() <= 128)) &&
             (!data.keys().hasAny(['totalStudents']) || (data.totalStudents is number && data.totalStudents >= 0 && data.totalStudents <= 500)) &&
             (!data.keys().hasAny(['roomNumber']) || (data.roomNumber is string && data.roomNumber.size() <= 80)) &&
             (!data.keys().hasAny(['subjects']) || (data.subjects is list && data.subjects.size() <= 60)) &&
             (!data.keys().hasAny(['isActive']) || data.isActive is bool) &&
             (!data.keys().hasAny(['sortOrder']) || (data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000)) &&
             (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 500)) &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidAcademicConfig(data) {
      return data.keys().hasAll(['components', 'gradingScale', 'rankingPolicy']) &&
             data.keys().hasOnly(['id', 'components', 'gradingScale', 'rankingPolicy', 'updatedBy', 'updatedAt']) &&
             (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() <= 128)) &&
             data.components is list && data.components.size() <= 15 &&
             data.gradingScale is list && data.gradingScale.size() <= 20 &&
             data.rankingPolicy in ['standard_competition', 'dense'] &&
             (!data.keys().hasAny(['updatedBy']) || (data.updatedBy is string && data.updatedBy.size() <= 120)) &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidSubjectAssignment(data) {
      return data.keys().hasAll(['className', 'subject', 'teacherId', 'teacherName']) &&
             data.keys().hasOnly(['id', 'className', 'subject', 'teacherId', 'teacherName', 'teacherEmail', 'updatedAt']) &&
             (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() <= 128)) &&
             data.className is string && data.className.size() > 0 && data.className.size() <= 60 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
             data.teacherId is string && data.teacherId.size() > 0 && data.teacherId.size() <= 128 &&
             data.teacherName is string && data.teacherName.size() > 0 && data.teacherName.size() <= 120 &&
             (!data.keys().hasAny(['teacherEmail']) || (data.teacherEmail is string && data.teacherEmail.size() <= 128)) &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidResultReview(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'admissionNo', 'className', 'term', 'session', 'status']) &&
             data.keys().hasOnly([
               'id', 'studentId', 'studentName', 'admissionNo', 'guardianEmail',
               'className', 'term', 'session', 'status',
               'teacherComment', 'teacherCommentBy', 'teacherCommentAt',
               'headComment', 'headCommentBy', 'headCommentTitle', 'headCommentAt', 'headSignature',
               'principalComment', 'principalCommentBy', 'principalCommentAt', 'principalSignature',
               'reviewedBy', 'reviewedAt', 'approvedBy', 'approvedAt',
               'returnNote', 'updatedAt'
             ]) &&
             (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() <= 128)) &&
             data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128 &&
             data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 150 &&
             data.admissionNo is string && data.admissionNo.size() > 0 && data.admissionNo.size() <= 30 &&
             (!data.keys().hasAny(['guardianEmail']) || (data.guardianEmail is string && data.guardianEmail.size() <= 128)) &&
             data.className is string && data.className.size() > 0 && data.className.size() <= 60 &&
             data.term in ['First Term', 'Second Term', 'Third Term'] &&
             data.session is string && data.session.size() > 0 && data.session.size() <= 40 &&
             data.status in ['Draft', 'Submitted for Review', 'Approved', 'Returned for Correction'] &&
             (!data.keys().hasAny(['teacherComment']) || (data.teacherComment is string && data.teacherComment.size() <= 500)) &&
             (!data.keys().hasAny(['teacherCommentBy']) || (data.teacherCommentBy is string && data.teacherCommentBy.size() <= 120)) &&
             (!data.keys().hasAny(['teacherCommentAt']) || (data.teacherCommentAt is string && data.teacherCommentAt.size() <= 50)) &&
             (!data.keys().hasAny(['headComment']) || (data.headComment is string && data.headComment.size() <= 500)) &&
             (!data.keys().hasAny(['headCommentBy']) || (data.headCommentBy is string && data.headCommentBy.size() <= 120)) &&
             (!data.keys().hasAny(['headCommentTitle']) || data.headCommentTitle in ['Headmaster', 'Headmistress']) &&
             (!data.keys().hasAny(['headCommentAt']) || (data.headCommentAt is string && data.headCommentAt.size() <= 50)) &&
             (!data.keys().hasAny(['headSignature']) || isValidDataImageUrl(data.headSignature, 350000)) &&
             (!data.keys().hasAny(['principalComment']) || (data.principalComment is string && data.principalComment.size() <= 500)) &&
             (!data.keys().hasAny(['principalCommentBy']) || (data.principalCommentBy is string && data.principalCommentBy.size() <= 120)) &&
             (!data.keys().hasAny(['principalCommentAt']) || (data.principalCommentAt is string && data.principalCommentAt.size() <= 50)) &&
             (!data.keys().hasAny(['principalSignature']) || isValidDataImageUrl(data.principalSignature, 350000)) &&
             (!data.keys().hasAny(['reviewedBy']) || (data.reviewedBy is string && data.reviewedBy.size() <= 120)) &&
             (!data.keys().hasAny(['reviewedAt']) || (data.reviewedAt is string && data.reviewedAt.size() <= 50)) &&
             (!data.keys().hasAny(['approvedBy']) || (data.approvedBy is string && data.approvedBy.size() <= 120)) &&
             (!data.keys().hasAny(['approvedAt']) || (data.approvedAt is string && data.approvedAt.size() <= 50)) &&
             (!data.keys().hasAny(['returnNote']) || (data.returnNote is string && data.returnNote.size() <= 500)) &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidAcademicRecord(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'admissionNo', 'className', 'subject', 'term', 'session', 'total', 'grade']) &&
             data.keys().hasOnly([
               'id', 'studentId', 'studentName', 'admissionNo', 'guardianEmail',
               'className', 'term', 'session', 'subject', 'ca1', 'ca2', 'exam',
               'componentScores', 'total', 'maxTotal', 'percentage', 'grade',
               'remark', 'enteredBy', 'isApproved', 'updatedAt'
             ]) &&
             (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() <= 128)) &&
             data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128 &&
             data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 150 &&
             data.admissionNo is string && data.admissionNo.size() > 0 && data.admissionNo.size() <= 30 &&
             (!data.keys().hasAny(['guardianEmail']) || (data.guardianEmail is string && data.guardianEmail.size() <= 128)) &&
             data.className is string && data.className.size() > 0 && data.className.size() <= 60 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
             data.term in ['First Term', 'Second Term', 'Third Term'] &&
             data.session is string && data.session.size() > 0 && data.session.size() <= 40 &&
             (!data.keys().hasAny(['ca1']) || (data.ca1 is number && data.ca1 >= 0 && data.ca1 <= 100)) &&
