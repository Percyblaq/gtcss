        "timeRange": { "type": "string", "maxLength": 40 },
        "className": { "type": "string", "maxLength": 60 },
        "subject": { "type": "string", "maxLength": 100 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "room": { "type": "string", "maxLength": 60 },
        "isBreak": { "type": "boolean" }
      },
      "required": ["day", "period", "timeRange", "className", "subject", "teacherName", "room"]
    }
  },
