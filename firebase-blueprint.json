      },
      "required": ["actionType", "studentId", "studentName", "admissionNo", "className", "session", "term", "studentFeeId", "categoryId", "categoryName", "receiptNo", "reason", "oldValues", "newValues", "performedBy", "performedByUid", "performedAt"]
    },
