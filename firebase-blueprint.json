        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "admissionNo": { "type": "string", "maxLength": 30 },
        "className": { "type": "string", "maxLength": 60 },
        "session": { "type": "string", "maxLength": 40 },
        "term": { "type": "string", "enum": ["First Term", "Second Term", "Third Term"] },
        "studentFeeId": { "type": "string", "maxLength": 128 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "paymentId": { "type": "string", "maxLength": 128 },
        "receiptNo": { "type": "string", "maxLength": 500 },
        "amount": { "type": "number" },
        "expectedAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Bank Transfer", "POS", "Cash", "Cheque", "Bank Teller / Deposit"] },
        "paymentDate": { "type": "string", "maxLength": 20 },
        "reason": { "type": "string", "maxLength": 300 },
        "deletedBy": { "type": "string", "maxLength": 120 },
        "deletedByUid": { "type": "string", "maxLength": 128 },
        "deletedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["deletionType", "studentId", "studentName", "admissionNo", "className", "session", "term", "studentFeeId", "categoryId", "categoryName", "receiptNo", "amount", "reason", "deletedBy", "deletedByUid", "deletedAt"]
    },
    "TimetableSlot": {
      "title": "TimetableSlot",
      "description": "Class weekly timetable period slot",
      "type": "object",
